@page "/"
@inject MeteoAPP.Services.ParameterService parameterService

<h1>Ciao da Blazor Hybrid!</h1>

<p>Questa è una pagina Blazor Hybrid in un'app MAUI</p>

<button class="btn btn-primary" @onclick="IncrementCount">Cliccami</button>

<p>Contatore: @count</p>

@code {
    [Parameter] public int Start { get; set; }
    private int count = 0;
    protected override void OnInitialized()
    {
        count = 0;
    }

    private void IncrementCount()
    {
        count++;
    }
}